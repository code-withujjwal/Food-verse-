# Copy this file to ".env" and fill in your key. Never commit ".env".
GEMINI_API_KEY=your-gemini-api-key-here

# Vision-capable Gemini model. Change this if Google retires the default.
GEMINI_MODEL=gemini-2.5-flash
# Seconds to wait for Gemini before giving up (minimum 5).
GEMINI_TIMEOUT_SECONDS=60

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

HOST=127.0.0.1
PORT=5000
# Debug mode exposes an interactive debugger. Keep it 0 except on your own machine.
FLASK_DEBUG=0

# POST requests allowed per client per minute (0 disables the limit).
RATE_LIMIT_PER_MINUTE=10
# Set to 1 only when running behind exactly one trusted reverse proxy.
TRUSTED_PROXY_COUNT=0
